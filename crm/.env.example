# Copia este archivo como ".env.local" y rellena los valores.
# En Vercel, estos mismos valores van en Settings → Environment Variables.

# Supabase → Project Settings → API (o "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave "publishable" (antes llamada "anon"). Es pública, puede ir al navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clave "secret" (antes llamada "service_role"). ¡SECRETA! Nunca la compartas.
# Solo la usa el servidor para dar de alta usuarios.
SUPABASE_SECRET_KEY=sb_secret_xxx
